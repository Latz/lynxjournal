{
  "name": "lynxjournal",
  "version": "1.0.0",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "env:logs": "wp-env logs",
    "test:all": "vendor/bin/pest --testsuite=Unit && vitest run",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:api": "playwright test tests/e2e/api",
    "test:e2e:ext": "playwright test --config=playwright.extension.config.mjs",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/scripts": "^30.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "rrule": "^2.8.1"
  },
  "overrides": {
    "axios": "^1.16.0",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  }
