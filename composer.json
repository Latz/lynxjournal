{
    "name": "latz/lynxjournal",
    "description": "LynxJournal WordPress plugin – curated link roundups",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "LynxJournal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LynxJournal\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "brain/monkey": "^2.7",
        "yoast/phpunit-polyfills": "^4.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "pest --testsuite=Unit",
        "test:unit": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration --bootstrap tests/bootstrap-integration.php",
        "i18n:pot": "wp i18n make-pot . languages/lynxjournal.pot --domain=lynxjournal --exclude=vendor,node_modules,tests,bin,dist,chrome-extension,memory",
        "check-compatibility": [
            "vendor/bin/phpcs --config-set installed_paths vendor/phpcompatibility/php-compatibility",
            "vendor/bin/phpcs -p src/ lynxjournal.php --standard=PHPCompatibility --extensions=php --runtime-set testVersion 8.2-"
        ]
    }
}
