{
	"manifest_version": 3,
	"name": "__MSG_appName__",
	"version": "1.1.0",
	"description": "__MSG_appDescription__",
	"default_locale": "en",
	"permissions": ["activeTab", "scripting", "storage", "notifications", "contextMenus", "cookies"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"host_permissions": ["http://*/*", "https://*/*"],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png",
			"256": "icons/icon256.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"options_page": "settings.html"
}
